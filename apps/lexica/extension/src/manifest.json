{
  "manifest_version": 3,
  "name": "Lexica Blend",
  "version": "0.5.0",
  "description": "Đọc web tiếng Việt, các từ bạn đang học hiện bằng tiếng Anh ngay trong câu.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexica Blend"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lexica.cortexlearn.app/*",
        "https://cortex-lexica.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "host_permissions": [
    "https://cortexapi-production-964a.up.railway.app/*"
  ]
}