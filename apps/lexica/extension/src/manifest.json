{
  "manifest_version": 3,
  "name": "Lexica Núm vặn",
  "version": "0.2.0",
  "description": "Đọc web tiếng Việt, các từ bạn đang học hiện bằng tiếng Anh ngay trong câu.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lexica Núm vặn"
  },
  "icons": {
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://lexica.cortexlearn.app/*",
        "https://cortex-lexica.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lexica.cortexlearn.app/*",
        "https://cortex-lexica.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}