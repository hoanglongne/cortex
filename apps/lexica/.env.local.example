# Supabase - Lexica
# Copy file này thành .env.local và điền thông tin Supabase project của bạn
# Lấy từ: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cortex Core API / Hub. Bỏ trống trên production = tắt tích hợp Cortex
# (dev tự dùng localhost:3001 / localhost:3000)
NEXT_PUBLIC_CORTEX_API_URL=
NEXT_PUBLIC_CORTEX_HUB_URL=

# Product analytics (PostHog). Bỏ trống = không gửi event.
# Lấy key ở PostHog → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_KEY=
# EU project: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The teacher app (apps/teach), e.g. https://teach.lexica.example
NEXT_PUBLIC_TEACH_URL=

# Thẻ, bài đọc, Drop do Lexica Studio xuất bản (apps/studio/README.md, bước 5).
# Bỏ trống = chỉ dùng thẻ có sẵn trong app.
NEXT_PUBLIC_CONTENT_MANIFEST_URL=https://<project>.supabase.co/storage/v1/object/public/lexica-content/packs/manifest.json

# Chấm phát âm trên máy (scripts/pron-pack/README.md).
# Nơi đặt pron/v1/. Bỏ trống = pron/v1/ cạnh NEXT_PUBLIC_CONTENT_MANIFEST_URL.
# NEXT_PUBLIC_PRON_PACK_URL=https://<project>.supabase.co/storage/v1/object/public/<bucket>/pron/v1/
# "on" = mời mọi người tải gói chấm. Bỏ trống = chỉ người thử mở /speak?pron=1.
# NEXT_PUBLIC_PRON_BETA=
